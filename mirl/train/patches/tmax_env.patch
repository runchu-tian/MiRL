+    def _dev_readonly(self) -> bool:
+        """Remount the sandbox's bind-mounted /dev nodes read-only in its mount namespace; True only if all are ro."""
+        try:
+            info = json.loads(subprocess.run(["apptainer", "instance", "list", "--json", self.instance_name],
