+                               capture_output=True, text=True, timeout=60)
+            ms = sysmounts()
+            return bool(ms) and all("ro" in f[5].split(",") for f in ms)
+        except Exception as e:  # noqa: BLE001
+            print(f"❌ read-only /sys check error: {e!r}"[:300])
+            return False
