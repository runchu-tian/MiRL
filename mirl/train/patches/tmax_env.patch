+def _cni_lock():
+    """With APPTAINER_NET_BRIDGE=1, serialize instance start/stop on this machine.
+    Many CNI bridge/firewall plugin runs at once contend for the iptables lock and get killed ("netplugin failed ...
+    signal: killed"): the sandbox fails to start or leaks its network rules. A no-op when the bridge is off."""
+    import contextlib, fcntl
+    if os.environ.get("APPTAINER_NET_BRIDGE", "0") != "1":
+        return contextlib.nullcontext()
+    slots = max(1, int(os.environ.get("APPTAINER_CNI_SLOTS", "1")))   # >1: up to N network set-ups at once
+
+    @contextlib.contextmanager
+    def _lock():
+        import time as _t
+        if slots == 1:
+            with open("/tmp/apptainer_cni.lock", "w") as fh:
+                fcntl.flock(fh, fcntl.LOCK_EX)
+                try:
+                    yield
+                finally:
+                    fcntl.flock(fh, fcntl.LOCK_UN)
+            return
+        while True:                       # take any free slot file
+            for k in range(slots):
+                fh = open("/tmp/apptainer_cni.lock" if k == 0 else f"/tmp/apptainer_cni.lock.{k}", "w")
+                try:
+                    fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                except BlockingIOError:
+                    fh.close(); continue
+                try:
+                    yield
+                finally:
+                    fcntl.flock(fh, fcntl.LOCK_UN); fh.close()
+                return
+            _t.sleep(0.05)
+    return _lock()
+
