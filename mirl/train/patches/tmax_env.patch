+                               capture_output=True, text=True, timeout=60)
+            mi = open(f"/proc/{pid}/mountinfo").read().splitlines()
+            ro = {d: any(l.split()[4] == f"/dev/{d}" and "ro" in l.split()[5].split(",") for l in mi) for d in self._DEV_RO_NODES}
+            return all(ro.values())
